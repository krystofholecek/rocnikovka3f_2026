# Zkopíruj jako .env (necommituje se) a vyplň. Skutečné hodnoty nikdy nedávej do gitu.
# Náhodný klíč: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Lokální vývoj: True. Na serveru vždy False (výchozí).
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- chat (všechno volitelné, výchozí hodnoty viz chat/settings.py) ---
# Složka s model.pt a tokenizer.json (výstup python -m llm2005.export)
# CHAT_MODEL_DIR=checkpoints/chat
# CHAT_DEVICE=auto
# CHAT_ALLOWED_ORIGINS=https://chronosllm.com,https://www.chronosllm.com
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_DAY=200
# CHAT_MAX_NEW_TOKENS=256
# CHAT_TIMEOUT_SECONDS=45

# --- Cloudflare Tunnel (jen pro docker compose --profile tunnel) ---
# Token z Cloudflare: Zero Trust -> Networks -> Tunnels -> Create tunnel (cloudflared)
# CLOUDFLARE_TUNNEL_TOKEN=
